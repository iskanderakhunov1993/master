# PostgreSQL used by Prisma migrations and the future Vercel runtime.
DATABASE_URL="postgresql://master_ryadom:master_ryadom@127.0.0.1:5432/master_ryadom?schema=public"

# SQLite used by the current runtime during the migration period.
DATABASE_FILENAME=master-ryadom.db
SESSION_TTL_DAYS=7
URGENCY_MULTIPLIER=2
NORMAL_MATCH_TTL_MINUTES=120
URGENT_MATCH_TTL_MINUTES=45
MASTER_OFFER_TTL_MINUTES=20
