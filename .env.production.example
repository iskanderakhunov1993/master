# Production environment example
# Use a managed SQL database (Postgres) in production. The original project uses SQLite for local dev.
# Provide SESSION_SECRET for secure cookie sessions.

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname
# Fallback filename only for local/dev usage (not recommended on Vercel)
DATABASE_FILENAME=master-ryadom.db

# Session
SESSION_TTL_DAYS=7
SESSION_SECRET=replace-with-strong-random-secret

# Matching / timing
URGENCY_MULTIPLIER=2
NORMAL_MATCH_TTL_MINUTES=120
URGENT_MATCH_TTL_MINUTES=45
MASTER_OFFER_TTL_MINUTES=20

# File storage (recommended: S3-compatible or object storage)
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket
S3_REGION=your-region
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret

# Optional: monitoring/alerts
SENTRY_DSN=

# NOTE:
# - Vercel serverless runtime does not support better-sqlite3 reliably. Use an external Postgres DB
#   (e.g., Supabase, Vercel Postgres, RDS) or deploy a dedicated Node server that hosts the SQLite file.
# - Keep secrets in the host's secret manager (Vercel Environment Variables, GitHub Secrets) — do not commit them.
